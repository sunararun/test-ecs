option_settings:
  aws:elasticbeanstalk:application:environment:
    SERVER_PORT: "5000"
    JVM_OPTIONS: "-javaagent:/var/app/current/target/agents/splunk-otel-javaagent.jar"
    OTEL_SERVICE_NAME: "first-ecs-jar-app"
    OTEL_RESOURCE_ATTRIBUTES: "deployment.environment=production"
    SPLUNK_REALM: "au0"
    # Set the real token with: eb setenv SPLUNK_ACCESS_TOKEN=<new token>
    SPLUNK_ACCESS_TOKEN: "6ZGQghv3ik0YuTjSmyLHww"
    OTEL_LOGS_EXPORTER: "none"
    # Stop Spring's built-in OTel starter exporting to localhost (agent handles telemetry)
    MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED: "false"
    MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENABLED: "false"
    MANAGEMENT_OPENTELEMETRY_LOGGING_EXPORT_OTLP_ENABLED: "false"

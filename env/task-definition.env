JAVA_TOOL_OPTIONS=-javaagent:/otel/splunk-otel-javaagent.jar
OTEL_SERVICE_NAME=first-ecs
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.version=0.0.1
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_LOGS_EXPORTER=none
SPLUNK_METRICS_ENABLED=false
SPLUNK_PROFILER_ENABLED=false